FROM python:3.10-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV GRADIO_SERVER_NAME=0.0.0.0
ENV GRADIO_SERVER_PORT=8080
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ libgdal-dev gdal-bin libproj-dev && rm -rf /var/lib/apt/lists/*
ENV CPLUS_INCLUDE_PATH=/usr/include/gdal
ENV C_INCLUDE_PATH=/usr/include/gdal
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY app.py .
COPY gold_model.pkl .
RUN mkdir -p /app/output/maps /app/output/geotiff /app/output/stack /app/output/reports
EXPOSE 8080
CMD ["python", "app.py"]
